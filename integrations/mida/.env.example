# The agent wallet's private key: 0x followed by 64 hex characters. Testnet only; never commit the real value.
AGENT_PRIVATE_KEY=
# The TrustLayer owner address that created the delegation (0x address).
TRUSTLAYER_OWNER=
# Absolute path of the Mida home created for this integration (for example /home/you/.mida-trustlayer).
MIDA_HOME=
# The Mida agent name created with `mida add-agent`. Default: trustlayer-agent
MIDA_AGENT=
# The folder the agent was approved for with `mida approve`. Default: this folder.
MIDA_PROJECT=
# Monad testnet RPC endpoint. Default: https://testnet-rpc.monad.xyz
MONAD_RPC_URL=
# DelegationRegistry contract address. Default: 0x088bc310c841fA5ed5b28F37050c3B419572b70d
DELEGATION_REGISTRY=
