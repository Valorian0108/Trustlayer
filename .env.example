# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Privy Configuration
VITE_PRIVY_APP_ID=your_privy_app_id_here

# Smart Contract Addresses (Monad Testnet)
VITE_DELEGATION_REGISTRY_ADDRESS=your_delegation_registry_address_here
VITE_AUTHORIZATION_VERIFIER_ADDRESS=your_authorization_verifier_address_here

# AuthorizationVerifierV2 (real on-chain Merkle verification — Step 1)
# Leave unset/empty to keep the demo simulation flow. Set to the deployed V2
# address (printed by deploy/deploy.mjs) to enable real proof verification.
VITE_AUTHORIZATION_VERIFIER_V2_ADDRESS=
